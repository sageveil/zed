        "terminal.ansi.dim_red": "#9A6B6B",
        "terminal.ansi.dim_green": "#959C70",
        "terminal.ansi.dim_yellow": "#A69966",
        "terminal.ansi.dim_blue": "#8A8493",
        "terminal.ansi.dim_magenta": "#876f7f",
        "terminal.ansi.dim_cyan": "#7F9476",
        "terminal.ansi.dim_white": "#8A928B",

