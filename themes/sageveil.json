        "conflict.border": "#A37F90",
        "created": "#7E9270",
        "created.background": "#7E927020",
        "created.border": "#7E9270",
        "deleted": "#9A6B6B",
        "deleted.background": "#9A6B6B20",
        "deleted.border": "#9A6B6B",
        "error": "#9A6B6B",
        "error.background": "#9A6B6B20",
        "error.border": "#9A6B6B",
        "hidden": "#616560",
        "hidden.background": "#1D2320",
        "hidden.border": "#1D2320",
        "hint": "#6F9476",
        "hint.background": "#6F947620",
        "hint.border": "#6F9476",
        "ignored": "#616560",
        "ignored.background": "#1D2320",
        "ignored.border": "#1D2320",
        "info": "#8A8294",
        "info.background": "#8A829420",
        "info.border": "#8A8294",
        "modified": "#AC9C66",
        "modified.background": "#AC9C6620",
        "modified.border": "#AC9C66",
        "predictive": "#8C918C",
        "predictive.background": "#8C918C20",
        "predictive.border": "#8C918C",
        "renamed": "#8A8294",
        "renamed.background": "#8A829420",
        "renamed.border": "#8A8294",
        "success": "#7E9270",
        "success.background": "#7E927020",
        "success.border": "#7E9270",
        "unreachable": "#616560",
        "unreachable.background": "#1D2320",
        "unreachable.border": "#1D2320",
        "warning": "#AC9C66",
        "warning.background": "#AC9C6620",
        "warning.border": "#AC9C66",

        "players": [
          { "cursor": "#A8AFA6", "background": "#A8AFA6", "selection": "#33423A" },
          { "cursor": "#7E9270",  "background": "#7E9270",  "selection": "#7E927040" },
          { "cursor": "#A37F90","background": "#A37F90","selection": "#A37F9040" },
          { "cursor": "#AC9C66", "background": "#AC9C66", "selection": "#AC9C6640" },
          { "cursor": "#8A8294",   "background": "#8A8294",   "selection": "#8A829440" },
          { "cursor": "#6F9476",   "background": "#6F9476",   "selection": "#6F947640" },
          { "cursor": "#9A6B6B",    "background": "#9A6B6B",    "selection": "#9A6B6B40" },
          { "cursor": "#BC9AAC", "background": "#BC9AAC", "selection": "#BC9AAC40" }
        ],

        "syntax": {
          "attribute":     { "color": "#AC9C66", "font_style": "italic" },
          "boolean":       { "color": "#88AB90" },
          "comment":       { "color": "#8C918C", "font_style": "italic" },
          "comment.doc":   { "color": "#8C918C", "font_style": "italic" },
          "constant":      { "color": "#88AB90" },
          "constructor":   { "color": "#AC9C66" },
          "embedded":      { "color": "#A8AFA6" },
          "emphasis":      { "color": "#A37F90", "font_style": "italic" },
          "emphasis.strong": { "color": "#AC9C66", "font_weight": 700 },
          "enum":          { "color": "#AC9C66" },
          "function":      { "color": "#7E9270" },
          "function.method": { "color": "#7E9270" },
          "function.special": { "color": "#AC9C66" },
          "hint":          { "color": "#8C918C", "font_style": "italic" },
          "keyword":       { "color": "#A37F90" },
          "keyword.import": { "color": "#8A8294" },
          "label":         { "color": "#A37F90" },
          "link_text":     { "color": "#A37F90" },
          "link_uri":      { "color": "#6F9476", "font_style": "italic" },
          "number":        { "color": "#88AB90" },
          "operator":      { "color": "#6F9476" },
          "predictive":    { "color": "#8C918C", "font_style": "italic" },
          "preproc":       { "color": "#8A8294" },
          "primary":       { "color": "#A8AFA6" },
          "property":      { "color": "#8A8294" },
          "punctuation":   { "color": "#A8AFA6" },
          "punctuation.bracket":    { "color": "#8C918C" },
          "punctuation.delimiter":  { "color": "#8C918C" },
          "punctuation.list_marker": { "color": "#6F9476" },
          "punctuation.special":    { "color": "#A37F90" },
          "string":        { "color": "#95A888" },
          "string.escape": { "color": "#BC9AAC" },
          "string.regex":  { "color": "#BC9AAC" },
          "string.special": { "color": "#BC9AAC" },
          "string.special.symbol": { "color": "#BC9AAC" },
          "tag":           { "color": "#A37F90" },
          "text.literal":  { "color": "#95A888" },
          "title":         { "color": "#7E9270", "font_weight": 700 },
          "type":          { "color": "#AC9C66" },
          "type.builtin":  { "color": "#AC9C66" },
          "variable":      { "color": "#A8AFA6" },
          "variable.special": { "color": "#9A6B6B" },
          "variant":       { "color": "#AC9C66" }
        }
