{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Sageveil",
  "author": "sageveil",
  "themes": [
    {
      "name": "Sageveil",
      "appearance": "dark",
      "style": {
        "border": "#4E504C",
        "border.variant": "#212723",
        "border.focused": "#959C70",
        "border.selected": "#959C70",
        "border.transparent": "#00000000",
        "border.disabled": "#6F7B6F",

        "elevated_surface.background": "#1C211E",
        "surface.background": "#1C211E",
        "background": "#101310",

        "element.background": "#1C211E",
        "element.hover": "#212723",
        "element.active": "#241d21",
        "element.selected": "#241d21",
        "element.disabled": "#1C211E",

        "drop_target.background": "#959C7040",

        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#212723",
        "ghost_element.active": "#241d21",
        "ghost_element.selected": "#241d21",
        "ghost_element.disabled": "#00000000",

        "text": "#A8AFA6",
        "text.muted": "#8A928B",
        "text.placeholder": "#8A928B",
        "text.disabled": "#6F7B6F",
        "text.accent": "#959C70",

        "icon": "#A8AFA6",
        "icon.muted": "#8A928B",
        "icon.disabled": "#6F7B6F",
        "icon.placeholder": "#8A928B",
        "icon.accent": "#959C70",

        "status_bar.background": "#1C211E",
        "title_bar.background": "#1C211E",
        "title_bar.inactive_background": "#1C211E",
        "toolbar.background": "#101310",
        "tab_bar.background": "#1C211E",
        "tab.inactive_background": "#1C211E",
        "tab.active_background": "#101310",

        "search.match_background": "#876f7f60",

        "panel.background": "#1C211E",
        "panel.focused_border": "#959C70",

        "pane.focused_border": "#959C70",

        "scrollbar.thumb.background": "#4E504C80",
        "scrollbar.thumb.hover_background": "#4E504C",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#101310",
        "scrollbar.track.border": "#212723",

        "editor.foreground": "#A8AFA6",
        "editor.background": "#101310",
        "editor.gutter.background": "#101310",
        "editor.subheader.background": "#1C211E",
        "editor.active_line.background": "#212723",
        "editor.highlighted_line.background": "#212723",
        "editor.line_number": "#6F7B6F",
        "editor.active_line_number": "#c3cdc0",
        "editor.invisible": "#6F7B6F",
        "editor.wrap_guide": "#212723",
        "editor.active_wrap_guide": "#4E504C",
        "editor.document_highlight.read_background": "#241d2160",
        "editor.document_highlight.write_background": "#241d2190",

        "terminal.background": "#101310",
        "terminal.foreground": "#A8AFA6",
        "terminal.bright_foreground": "#c3cdc0",
        "terminal.dim_foreground": "#8A928B",
        "terminal.ansi.black": "#101310",
        "terminal.ansi.red": "#9A6B6B",
        "terminal.ansi.green": "#959C70",
        "terminal.ansi.yellow": "#A69966",
        "terminal.ansi.blue": "#8A8493",
        "terminal.ansi.magenta": "#876f7f",
        "terminal.ansi.cyan": "#7F9476",
        "terminal.ansi.white": "#A8AFA6",
        "terminal.ansi.bright_black": "#262F26",
        "terminal.ansi.bright_red": "#B08585",
        "terminal.ansi.bright_green": "#9C9F7F",
        "terminal.ansi.bright_yellow": "#C6B67E",
        "terminal.ansi.bright_blue": "#A39DAC",
