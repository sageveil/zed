{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Sageveil",
  "author": "sageveil",
  "themes": [
    {
      "name": "Sageveil",
      "appearance": "dark",
      "style": {
        "border": "#4E504C",
        "border.variant": "#1F2624",
        "border.focused": "#7E9270",
        "border.selected": "#7E9270",
        "border.transparent": "#00000000",
        "border.disabled": "#616560",

        "elevated_surface.background": "#1D2320",
        "surface.background": "#1D2320",
        "background": "#101411",

        "element.background": "#1D2320",
        "element.hover": "#1F2624",
        "element.active": "#33423A",
        "element.selected": "#33423A",
        "element.disabled": "#1D2320",

        "drop_target.background": "#7E927040",

        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#1F2624",
        "ghost_element.active": "#33423A",
        "ghost_element.selected": "#33423A",
        "ghost_element.disabled": "#00000000",

        "text": "#A8AFA6",
        "text.muted": "#8C918C",
        "text.placeholder": "#8C918C",
        "text.disabled": "#616560",
        "text.accent": "#7E9270",

        "icon": "#A8AFA6",
        "icon.muted": "#8C918C",
        "icon.disabled": "#616560",
        "icon.placeholder": "#8C918C",
        "icon.accent": "#7E9270",

        "status_bar.background": "#1D2320",
        "title_bar.background": "#1D2320",
        "title_bar.inactive_background": "#1D2320",
        "toolbar.background": "#101411",
        "tab_bar.background": "#1D2320",
        "tab.inactive_background": "#1D2320",
        "tab.active_background": "#101411",

        "search.match_background": "#A37F9060",

        "panel.background": "#1D2320",
        "panel.focused_border": "#7E9270",

        "pane.focused_border": "#7E9270",

        "scrollbar.thumb.background": "#4E504C80",
        "scrollbar.thumb.hover_background": "#4E504C",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#101411",
        "scrollbar.track.border": "#1F2624",

        "editor.foreground": "#A8AFA6",
        "editor.background": "#101411",
        "editor.gutter.background": "#101411",
        "editor.subheader.background": "#1D2320",
        "editor.active_line.background": "#1F2624",
        "editor.highlighted_line.background": "#1F2624",
        "editor.line_number": "#616560",
        "editor.active_line_number": "#c3cdc0",
        "editor.invisible": "#616560",
        "editor.wrap_guide": "#1F2624",
        "editor.active_wrap_guide": "#4E504C",
        "editor.document_highlight.read_background": "#33423A60",
        "editor.document_highlight.write_background": "#33423A90",

        "terminal.background": "#101411",
        "terminal.foreground": "#A8AFA6",
        "terminal.bright_foreground": "#c3cdc0",
        "terminal.dim_foreground": "#8C918C",
        "terminal.ansi.black": "#101411",
        "terminal.ansi.red": "#9A6B6B",
        "terminal.ansi.green": "#7E9270",
        "terminal.ansi.yellow": "#AC9C66",
        "terminal.ansi.blue": "#8A8294",
        "terminal.ansi.magenta": "#A37F90",
        "terminal.ansi.cyan": "#6F9476",
        "terminal.ansi.white": "#A8AFA6",
        "terminal.ansi.bright_black": "#26322A",
        "terminal.ansi.bright_red": "#B08585",
        "terminal.ansi.bright_green": "#95A888",
        "terminal.ansi.bright_yellow": "#C6B67E",
        "terminal.ansi.bright_blue": "#A39DAC",
        "terminal.ansi.bright_magenta": "#BC9AAC",
        "terminal.ansi.bright_cyan": "#88AB90",
        "terminal.ansi.bright_white": "#c3cdc0",
        "terminal.ansi.dim_black": "#101411",
        "terminal.ansi.dim_red": "#9A6B6B",
        "terminal.ansi.dim_green": "#7E9270",
        "terminal.ansi.dim_yellow": "#AC9C66",
        "terminal.ansi.dim_blue": "#8A8294",
        "terminal.ansi.dim_magenta": "#A37F90",
        "terminal.ansi.dim_cyan": "#6F9476",
        "terminal.ansi.dim_white": "#8C918C",

