        "created.background": "#959C7020",
        "created.border": "#959C70",
        "deleted": "#9A6B6B",
        "deleted.background": "#9A6B6B20",
        "deleted.border": "#9A6B6B",
        "error": "#9A6B6B",
        "error.background": "#9A6B6B20",
        "error.border": "#9A6B6B",
        "hidden": "#6F7B6F",
        "hidden.background": "#1C211E",
        "hidden.border": "#1C211E",
        "hint": "#7F9476",
        "hint.background": "#7F947620",
        "hint.border": "#7F9476",
        "ignored": "#6F7B6F",
        "ignored.background": "#1C211E",
        "ignored.border": "#1C211E",
        "info": "#8A8493",
        "info.background": "#8A849320",
        "info.border": "#8A8493",
        "modified": "#A69966",
        "modified.background": "#A6996620",
        "modified.border": "#A69966",
        "predictive": "#8A928B",
        "predictive.background": "#8A928B20",
        "predictive.border": "#8A928B",
        "renamed": "#8A8493",
        "renamed.background": "#8A849320",
        "renamed.border": "#8A8493",
        "success": "#959C70",
        "success.background": "#959C7020",
        "success.border": "#959C70",
        "unreachable": "#6F7B6F",
        "unreachable.background": "#1C211E",
        "unreachable.border": "#1C211E",
        "warning": "#A69966",
        "warning.background": "#A6996620",
        "warning.border": "#A69966",

        "players": [
          { "cursor": "#A8AFA6", "background": "#A8AFA6", "selection": "#241d21" },
          { "cursor": "#959C70",  "background": "#959C70",  "selection": "#959C7040" },
          { "cursor": "#876f7f","background": "#876f7f","selection": "#876f7f40" },
          { "cursor": "#A69966", "background": "#A69966", "selection": "#A6996640" },
          { "cursor": "#8A8493",   "background": "#8A8493",   "selection": "#8A849340" },
          { "cursor": "#7F9476",   "background": "#7F9476",   "selection": "#7F947640" },
          { "cursor": "#9A6B6B",    "background": "#9A6B6B",    "selection": "#9A6B6B40" },
          { "cursor": "#947e8d", "background": "#947e8d", "selection": "#947e8d40" }
        ],

        "syntax": {
          "attribute":     { "color": "#A69966", "font_style": "italic" },
          "boolean":       { "color": "#9AAB90" },
          "comment":       { "color": "#8A928B", "font_style": "italic" },
          "comment.doc":   { "color": "#8A928B", "font_style": "italic" },
          "constant":      { "color": "#9AAB90" },
          "constructor":   { "color": "#A69966" },
          "embedded":      { "color": "#A8AFA6" },
          "emphasis":      { "color": "#876f7f", "font_style": "italic" },
          "emphasis.strong": { "color": "#A69966", "font_weight": 700 },
          "enum":          { "color": "#A69966" },
          "function":      { "color": "#959C70" },
          "function.method": { "color": "#959C70" },
          "function.special": { "color": "#A69966" },
          "hint":          { "color": "#8A928B", "font_style": "italic" },
          "keyword":       { "color": "#876f7f" },
          "keyword.import": { "color": "#8A8493" },
          "label":         { "color": "#876f7f" },
          "link_text":     { "color": "#876f7f" },
          "link_uri":      { "color": "#7F9476", "font_style": "italic" },
          "number":        { "color": "#9AAB90" },
          "operator":      { "color": "#7F9476" },
          "predictive":    { "color": "#8A928B", "font_style": "italic" },
          "preproc":       { "color": "#8A8493" },
          "primary":       { "color": "#A8AFA6" },
          "property":      { "color": "#8A8493" },
          "punctuation":   { "color": "#A8AFA6" },
          "punctuation.bracket":    { "color": "#8A928B" },
          "punctuation.delimiter":  { "color": "#8A928B" },
          "punctuation.list_marker": { "color": "#7F9476" },
          "punctuation.special":    { "color": "#876f7f" },
          "string":        { "color": "#9C9F7F" },
          "string.escape": { "color": "#947e8d" },
          "string.regex":  { "color": "#947e8d" },
          "string.special": { "color": "#947e8d" },
          "string.special.symbol": { "color": "#947e8d" },
          "tag":           { "color": "#876f7f" },
          "text.literal":  { "color": "#9C9F7F" },
          "title":         { "color": "#959C70", "font_weight": 700 },
          "type":          { "color": "#A69966" },
          "type.builtin":  { "color": "#A69966" },
          "variable":      { "color": "#A8AFA6" },
          "variable.special": { "color": "#9A6B6B" },
          "variant":       { "color": "#A69966" }
        }
